<!-- Unit and range strings used by format/LocaleMeasurementFormatter (T-004). -->
<!-- A no-break space (\u00A0) keeps each number on the same line as its unit. -->
<resources>
    <string name="unit_kilometer">km</string>
    <string name="unit_mile">mi</string>
    <string name="unit_kilogram">kg</string>
    <string name="unit_pound">lb</string>
    <!-- %1$s is a formatted number of beats per minute. -->
    <string name="format_heart_rate">%1$s\u00A0bpm</string>
    <!-- %1$s is hours, %2$s is minutes, both formatted numbers. -->
    <string name="format_duration_hours_minutes">%1$s\u00A0h %2$s\u00A0min</string>
    <string name="format_duration_hours">%1$s\u00A0h</string>
    <string name="format_duration_minutes">%1$s\u00A0min</string>
    <string name="range_today">Today</string>
    <string name="range_yesterday">Yesterday</string>
</resources>
